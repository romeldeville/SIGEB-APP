# SIGEB — Variables d'environnement (copier en .env et remplacer TOUS les secrets en prod)
SIGEB_DOMAIN=sigeb.cenc.cm

# PostgreSQL
FLYWAY_USER=sigeb_owner
FLYWAY_PASSWORD=CHANGEZ_MOI_OWNER_FORT
DB_USER=sigeb_app
DB_PASSWORD=CHANGEZ_MOI_APP_FORT

# Sécurité applicative (minimum 32 caractères aléatoires)
SIGEB_SECURITY_JWT_SECRET=CHANGEZ_MOI_SECRET_JWT_TRES_LONG_ALEATOIRE
SIGEB_SECURITY_MASTER_KEY=CHANGEZ_MOI_CLE_MAITRE_AES256_TRES_LONGUE

# Super Admin initial (changement forcé à la 1re connexion)
SIGEB_BOOTSTRAP_ADMIN_IDENTIFIANT=admin@sigeb.cm
SIGEB_BOOTSTRAP_ADMIN_PASSWORD=CHANGEZ_MOI_MDP_ADMIN_INITIAL

# Clé publique age pour chiffrement des sauvegardes hors-serveur
BACKUP_AGE_PUBLIC_KEY=
